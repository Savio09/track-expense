rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Historical root collections remain private. Guests only access their own demo.
    match /visitors/{userId}/items/{itemId} {
      function owner() { return request.auth != null && request.auth.uid == userId; }
      allow read, delete: if owner();
      allow create, update: if owner()
        && request.resource.data.keys().hasOnly(['name', 'price'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120 && request.resource.data.price is number && request.resource.data.price > 0 && request.resource.data.price <= 1000000000;
    }
  }
}
